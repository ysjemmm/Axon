# LLM API 配置
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 服务配置
PORT=3001
WORKSPACE_DIR=D:\projects\Axon

# Web 搜索（Tavily 为主，留空时自动降级到 DuckDuckGo）
TAVILY_API_KEY=tvly-xxx

# 上下文滚动压缩（默认关闭，与 VS Code 扩展 axon.compaction.enabled 一致）
# 开启后长对话会自动把早期消息压缩为摘要，节省 Token；代价是早期细节丢失。
# AXON_COMPACTION_ENABLED=true
# AXON_COMPACTION_TRIGGER_TOKENS=30000
# AXON_COMPACTION_KEEP_RECENT=8
