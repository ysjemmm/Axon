{
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    // 扩展把 @axon/core / host-node / host-vscode 声明成 workspace devDependencies（打包进 dist，
    // 运行时不需要），"^build" 据此推导出构建顺序。outputs 要带上 media/web/**：webview 产物由
    // copy-web.mjs 写进这里，漏掉的话 turbo 的缓存命中会跳过构建、却不恢复这部分产物。
    "axon-ide#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "media/web/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
